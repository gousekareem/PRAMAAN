{
  "name": "pramaan-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "PRAMAAN Android duty application (React Native CLI + Kotlin native modules). Installed with npm, outside the pnpm workspace.",
  "scripts": {
    "android": "react-native run-android",
    "start": "react-native start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "build:android:debug": "cd android && gradlew assembleDebug",
    "build:android:release": "cd android && gradlew assembleRelease",
    "test:android:unit": "cd android && gradlew testDebugUnitTest"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "@op-engineering/op-sqlite": "15.2.14",
    "@react-native-community/netinfo": "11.5.2",
    "@react-navigation/native": "7.5.0",
    "@react-navigation/native-stack": "7.20.0",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-get-random-values": "2.0.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.29.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@babel/plugin-transform-export-namespace-from": "7.27.1",
    "@babel/preset-env": "7.28.5",
    "@babel/runtime": "7.28.4",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.20.5",
    "@types/react": "19.2.2",
    "better-sqlite3": "12.4.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "op-sqlite": {
    "sqlcipher": true
  }
}
