    "@testing-library/user-event": "14.6.1",
    "@types/geojson": "7946.0.16",
    "@types/leaflet": "1.9.21",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "autoprefixer": "10.4.21",
    "jsdom": "26.1.0",
