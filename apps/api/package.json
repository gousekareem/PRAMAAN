{
  "name": "@pramaan/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PRAMAAN backend API (Express + PostgreSQL/PostGIS).",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node dist/server.js",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/database/migrate-cli.ts",
    "db:migrate:prod": "node dist/database/migrate-cli.js",
    "db:seed": "tsx --env-file-if-exists=../../.env src/database/seed-cli.ts",
    "db:verify-audit": "tsx --env-file-if-exists=../../.env src/tools/verify-audit-cli.ts",
    "simulate": "tsx --env-file-if-exists=../../.env src/tools/simulate-device.ts",
    "bench": "tsx --env-file-if-exists=../../.env src/tools/benchmark.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@node-rs/argon2": "2.0.2",
    "@pramaan/event-contracts": "workspace:*",
    "@pramaan/validation": "workspace:*",
    "@pramaan/verifier": "workspace:*",
    "busboy": "1.6.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "express": "5.1.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.1.0",
    "jose": "6.1.0",
    "jpeg-js": "0.4.4",
    "pdfkit": "0.17.2",
    "pg": "8.16.3",
    "pino": "9.13.1",
    "pino-http": "10.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/busboy": "1.5.4",
    "@types/cookie-parser": "1.4.9",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/node": "22.20.5",
    "@types/pdfkit": "0.17.3",
    "@types/pg": "8.15.5",
    "@types/supertest": "6.0.3",
    "fflate": "0.8.3",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
