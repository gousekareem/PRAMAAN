# ---------------------------------------------------------------------------
# PRAMAAN API configuration (copy to .env for LOCAL DEVELOPMENT only).
# Placeholders only — never commit a real .env. Production values are set in the
# Render dashboard (see PRAMAAN_WINDOWS_AND_RENDER_DEPLOYMENT_GUIDE.md).
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Docker Compose database (docker compose up -d db). Format: postgres://user:password@host:port/db
DATABASE_URL=postgres://pramaan:pramaan_dev_only@localhost:5432/pramaan
# disable = no TLS (local / Render private network); verify-full = TLS with certificate verification
DATABASE_SSL_MODE=disable
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----...  (only for verify-full with a private CA)
DATABASE_POOL_MAX=10

# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-48-random-bytes-base64url-generated-locally
JWT_ISSUER=pramaan-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated exact origins of the dashboard
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Cookies: Secure is forced in production. SameSite=none only when dashboard and API are on different sites.
COOKIE_SAMESITE=strict
# Number of reverse proxies in front of the API (Render: 1)
TRUST_PROXY=0

# Evidence storage (MUST be a persistent disk in production)
EVIDENCE_STORAGE_DIR=./storage/evidence
MAX_EVIDENCE_BYTES=8388608
MAX_JSON_BODY_BYTES=2097152
MAX_UPLOAD_ATTEMPTS=5

RATE_LIMIT_GENERAL_PER_MIN=600
RATE_LIMIT_LOGIN_PER_15MIN=10
RATE_LIMIT_SYNC_PER_MIN=120
FUTURE_SKEW_TOLERANCE_MS=300000
DUTY_GRACE_MINUTES=120
RUN_MIGRATIONS_ON_START=false
LOG_LEVEL=info

# Synthetic demo data (development only; refused when NODE_ENV=production)
ALLOW_DEMO_SEED=true
# Development-only password for ALL demo accounts (12+ chars, upper, lower, digit). Never reuse elsewhere.
SEED_DEMO_PASSWORD=Demo-Only-Passw0rd

# Test database (pnpm test). Docker Compose default:
TEST_DATABASE_ADMIN_URL=postgres://pramaan:pramaan_dev_only@localhost:5432/postgres
